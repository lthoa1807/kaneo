# UAT environment. Copy to .env.uat (gitignored) on the production host.
# Every secret here must DIFFER from production: UAT shares the host, and the
# whole point is testing a migration and a login flow without prod data risk.
KANEO_CLIENT_URL=https://uat.example.com
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
POSTGRES_PASSWORD=
# 32+ chars, generate once and keep it: openssl rand -hex 32
AUTH_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=
